DATABASE_URL="mysql://user:password@host:port/dbname" # Replace with your local DB URL

AUTH_SECRET= # Run `pnpm dlx auth`. Read more: https://cli.authjs.dev
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://yourdomain/api/auth/callback/google

MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://yourdomain/api/auth/callback/microsoft

# 32-byte hex string for encrypting Apple app-specific passwords
ENCRYPTION_KEY=your_32_byte_hex_key_here