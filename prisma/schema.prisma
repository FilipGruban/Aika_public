// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          Role      @default(user)
  premium       DateTime?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts            Account[]
  verificationTokens  VerificationToken[]
  logs                ChangeLog[]
  passwordResetTokens PasswordResetToken[]
  Calendar            Calendar[]
  Notification        Notification[]
  CalendarGroup       CalendarGroup[]

  @@map("users")
}

enum Role {
  user
  admin
}

model Account {
  id             String    @id @default(cuid())
  provider       Provider
  providerUserId String    @unique @map("provider_user_id")
  accessToken    String?   @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  expiresIn      DateTime? @map("expires_in")
  providerEmail  String    @map("provider_email")

  username   String?
  credential String? @db.Text

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  calendars Calendar[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, provider], name: "UserWithProvider")
  @@map("accounts")
}

enum Provider {
  google
  microsoft
  apple
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @map("user_id")
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model CalendarGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  calendars Calendar[] @relation("GroupCalendars")

  primaryCalendarId String   @unique @map("primary_calendar_id")
  primaryCalendar   Calendar @relation("PrimaryCalendar", fields: [primaryCalendarId], references: [id])

  @@map("calendar_groups")
}

model Calendar {
  id                 String     @id @default(cuid())
  providerCalendarId String     @unique @map("provider_calendar_id")
  provider           Provider
  name               String
  timeZone           String?    @default("UTC") @map("time_zone")
  accessRole         AccessRole @map("access_role")
  lastSyncedAt       DateTime?  @map("last_synced_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  User      User        @relation(fields: [userId], references: [id])
  userId    String      @map("user_id")
  events    Event[]
  ChangeLog ChangeLog[]
  account   Account     @relation(fields: [accountId], references: [id])
  accountId String      @map("account_id")

  group   CalendarGroup? @relation("GroupCalendars", fields: [groupId], references: [id])
  groupId String?        @map("group_id")

  primaryOf CalendarGroup? @relation("PrimaryCalendar")

  @@map("calendars")
}

enum AccessRole {
  owner
  reader
  writer
}

model Event {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  provider           Provider
  providerCalendarId String   @map("provider_calendar_id")
  externalId         String   @map("external_id")

  recurrenceRule String?  @map("recurrence_rule")
  title          String
  description    String?
  start          DateTime
  end            DateTime
  location       String?
  status         String?
  isAllDay       Boolean  @default(false) @map("is_all_day")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  calendar   Calendar? @relation(fields: [calendarId], references: [id])
  calendarId String?   @map("calendar_id")

  @@unique([userId, provider, externalId])
  @@index([userId, providerCalendarId])
  @@map("events")
}

model ChangeLog {
  id         Int       @id @default(autoincrement())
  type       String
  action     String
  details    String?
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @map("user_id")
  calendar   Calendar? @relation(fields: [calendarId], references: [id])
  calendarId String?   @map("calendar_id")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("change_logs")
}

model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  type    NotificationType
  title   String
  message String?
  link    String?
  read    Boolean          @default(false)
  seenAt  DateTime?        @map("seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

enum NotificationType {
  verification
  sync
  alert
  error
  payment
}
