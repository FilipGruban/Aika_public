// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  password      String
  role          Role      @default(USER)
  premium       Boolean   @default(false)
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts            Account[]
  verificationTokens  VerificationToken[]
  logs                ChangeLog[]
  passwordResetTokens PasswordResetToken[]
  Calendar            Calendar[]
  Event               Event[]
  Notification        Notification[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

model Account {
  id             String    @id @default(cuid())
  provider       Provider
  providerUserId String    @unique @map("provider_user_id")
  accessToken    String?   @map("access_token") @db.Text
  refreshToken   String?   @map("refresh_token") @db.Text
  expiresIn      DateTime? @map("expires_in")
  providerEmail  String    @map("provider_email")

  username   String?
  credential String? @db.Text

  user      User       @relation(fields: [userId], references: [id])
  userId    String     @map("user_id")
  calendars Calendar[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@unique([userId, provider], name: "UserWithProvider")
  @@map("accounts")
}

enum Provider {
  google
  microsoft
  apple
}

model VerificationToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    String   @map("user_id")
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Calendar {
  id                 String     @id @default(cuid())
  providerCalendarId String     @map("provider_calendar_id")
  name               String
  description        String?
  timeZone           String?    @map("time_zone")
  primary            Boolean    @default(false)
  selected           Boolean    @default(true)
  accessRole         AccessRole @map("access_role")
  lastSyncedAt       DateTime?  @map("last_synced_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  User      User?       @relation(fields: [userId], references: [id])
  userId    String?     @map("user_id")
  events    Event[]
  ChangeLog ChangeLog[]
  account   Account     @relation(fields: [accountId], references: [id])
  accountId String      @map("account_id")
}

enum AccessRole {
  owner
  reader
  writer
}

model Event {
  id         String   @id @default(cuid())
  calendar   Calendar @relation(fields: [calendarId], references: [id])
  calendarId String   @map("calendar_id")

  providerEventId String   @map("provider_event_id")
  title           String
  description     String?
  start           DateTime
  end             DateTime
  allDay          Boolean  @default(false) @map("all_day_event")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @map("user_id")

  @@unique([calendarId, providerEventId])
}

model ChangeLog {
  id         Int       @id @default(autoincrement())
  type       String
  action     String
  details    String?
  user       User?     @relation(fields: [userId], references: [id])
  userId     String?   @map("user_id")
  calendar   Calendar? @relation(fields: [calendarId], references: [id])
  calendarId String?   @map("calendar_id")
  createdAt  DateTime  @default(now()) @map("created_at")
}

model Notification {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id")

  type    NotificationType
  title   String
  message String?
  link    String?
  read    Boolean          @default(false)
  seenAt  DateTime?        @map("seen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

enum NotificationType {
  verification
  sync
  alert
  payment
}
